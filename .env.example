# LABUBU bot configuration.
# Copy this file to .env and fill in the real values.
# NEVER commit a real .env, and never paste its contents into chat.

# Telegram bot token from @BotFather (required to run the bot)
BOT_TOKEN=

# Bot username without @ (e.g. LabubuMiningBot) — used for referral links
BOT_USERNAME=

# Telegram user id of the project admin/owner (for /approve_withdraw etc.)
ADMIN_TELEGRAM_ID=

# LABUBU Jetton master contract on TON mainnet
JETTON_MASTER=EQC4E35T2HhooVyuKj5I6OEh7JH4sFvxvkyHVqKnAiOsrWEN

# Treasury wallet that receives GRAM for manual buys (TON address, EQ.../UQ...)
# Leave empty until the owner decides which wallet receives sale payments.
TREASURY_ADDRESS=

# Public URL of the Mini App (the deployed public/index.html).
# Used for the web_app button in the bot menu. Leave empty until hosted.
MINI_APP_URL=

# HTTP port for the API + Mini App server
PORT=3000

# Set to "false" to run the API server only (no Telegram bot polling).
# Useful for local testing and for split hosting.
RUN_BOT=true
